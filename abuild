#!/usr/bin/env bash
# abuild — build AUR packages on GitHub Actions, then install locally.
set -euo pipefail

# --- TTY & Colors ---
USE_COLOR=0
[[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]] && USE_COLOR=1

C_RESET=""; C_BOLD=""; C_DIM=""; C_CYAN=""; C_GREEN=""; C_RED=""; C_YELLOW=""
if (( USE_COLOR )); then
  C_RESET="\e[0m"; C_BOLD="\e[1m"; C_DIM="\e[2m"
  C_CYAN="\e[36m"; C_GREEN="\e[32m"; C_RED="\e[31m"; C_YELLOW="\e[33m"
fi

# --- Spinner State ---
_SPIN_PID=""; _SPIN_MSG_FILE=""
CURRENT_RUN_ID=""; CURRENT_RUN_URL=""

spin_start() {
  local msg="$1"
  (( ! USE_COLOR )) && { printf "  ... %s\n" "$msg"; return 0; }
  printf "\e[?25l"
  _SPIN_MSG_FILE="$(mktemp -t abuild_spin.XXXXXX)"
  printf "%s" "$msg" > "$_SPIN_MSG_FILE"
  (
    local -a frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local count=${#frames[@]} i=0
    while [[ -f "$_SPIN_MSG_FILE" ]]; do
      printf "\r\e[2K  \e[36m%s\e[0m %s" "${frames[i]}" "$(<"$_SPIN_MSG_FILE")"
      i=$(( (i + 1) % count ))
      sleep 0.07
    done
  ) &
  _SPIN_PID=$!
}

spin_set() {
  local msg="$1"
  if [[ -n "$_SPIN_PID" && -f "${_SPIN_MSG_FILE:-}" ]]; then
    printf "%s" "$msg" > "$_SPIN_MSG_FILE"
  elif (( ! USE_COLOR )); then
    printf "  ... %s\n" "$msg"
  fi
}

spin_stop() {
  local status="${1:-ok}" msg="${2:-}"
  [[ -n "$_SPIN_PID" ]] && { kill "$_SPIN_PID" 2>/dev/null || true; wait "$_SPIN_PID" 2>/dev/null || true; _SPIN_PID=""; }
  [[ -n "$_SPIN_MSG_FILE" ]] && { rm -f "$_SPIN_MSG_FILE" 2>/dev/null || true; _SPIN_MSG_FILE=""; }
  (( USE_COLOR )) && printf "\e[?25h\r\e[2K"
  [[ -z "$msg" ]] && return 0
  case "$status" in
    ok)   printf "  ${C_GREEN}✔${C_RESET} %s\n" "$msg" ;;
    fail) printf "  ${C_RED}✖${C_RESET} %s\n" "$msg" ;;
    *)    printf "    %s\n" "$msg" ;;
  esac
}

cleanup() {
  local code=$?
  (( USE_COLOR )) && printf "\e[?25h" 2>/dev/null || true
  [[ -n "${_SPIN_PID:-}" ]] && { kill "$_SPIN_PID" 2>/dev/null || true; wait "$_SPIN_PID" 2>/dev/null || true; }
  [[ -n "${_SPIN_MSG_FILE:-}" && -f "$_SPIN_MSG_FILE" ]] && rm -f "$_SPIN_MSG_FILE" 2>/dev/null || true
  exit "$code"
}
trap cleanup EXIT

on_interrupt() {
  (( USE_COLOR )) && printf "\e[?25h\r\e[2K"
  [[ -n "${_SPIN_PID:-}" ]] && { kill "$_SPIN_PID" 2>/dev/null || true; wait "$_SPIN_PID" 2>/dev/null || true; }
  printf "\n  ${C_YELLOW}⚠${C_RESET} Interrupted — build continues remotely in background\n"
  if [[ -n "${CURRENT_RUN_ID:-}" ]]; then
    printf "    ${C_DIM}Reattach:${C_RESET} abuild --attach %s\n" "$CURRENT_RUN_ID"
    printf "    ${C_DIM}Run URL:${C_RESET}  %s\n\n" "${CURRENT_RUN_URL:-}"
  fi
  exit 130
}
trap on_interrupt INT TERM HUP

die() { spin_stop fail "$*"; exit 1; }

format_time() {
  local ms="${1:-0}"
  local s=$(( ms / 1000 ))
  (( ms < 1000 )) && { printf "%dms" "$ms"; return; }
  (( s < 60 )) && { printf "%d.%ds" "$s" "$(( (ms % 1000) / 100 ))"; return; }
  printf "%dm %02ds" "$(( s / 60 ))" "$(( s % 60 ))"
}

now_ms() { printf "%d" "$(( $(date +%s%N) / 1000000 ))"; }

# --- CLI Options ---
DETACH=0; ATTACH_ID=""
NO_INSTALL="${AUR_BUILDER_NOINSTALL:-0}"
REPO="${AUR_BUILDER_REPO:-}"
WORKFLOW="${AUR_BUILDER_WORKFLOW:-build.yml}"
DL_DIR="${AUR_BUILDER_DL:-/tmp/abuild}"

usage() {
  cat <<EOF
Usage: abuild [options] <pkgname> [aur-dep...]
       abuild --attach <run_id>

Options:
  -b, --detach        Dispatch build to background and exit immediately
  -a, --attach <id>   Attach to an existing or background build run
  -n, --no-install    Download package only, skip pacman -U
  -r, --repo <repo>   GitHub target repository (default: <login>/aur-builder)
  -h, --help          Show this help message
EOF
  exit 0
}

declare -a PKG_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -b|--detach|--background) DETACH=1; shift ;;
    -a|--attach) [[ $# -ge 2 ]] || die "missing run ID for $1"; ATTACH_ID="$2"; shift 2 ;;
    -n|--no-install) NO_INSTALL=1; shift ;;
    -r|--repo) [[ $# -ge 2 ]] || die "missing argument for $1"; REPO="$2"; shift 2 ;;
    *) PKG_ARGS+=("$1"); shift ;;
  esac
done

if [[ -z "$REPO" ]]; then
  _login="$(gh api user --jq .login 2>/dev/null || true)"
  [[ -n "$_login" ]] || die "GitHub CLI not authenticated. Run 'gh auth login'."
  REPO="$_login/aur-builder"
fi

TOTAL_START=$(now_ms)

# --- Attach Mode vs Fresh Build ---
if [[ -n "$ATTACH_ID" ]]; then
  CURRENT_RUN_ID="$ATTACH_ID"
  CURRENT_RUN_URL="https://github.com/$REPO/actions/runs/$CURRENT_RUN_ID"
  MAIN_PKG="attached-build"
  spin_start "Connecting to run ${C_BOLD}#${CURRENT_RUN_ID}${C_RESET}..."
else
  [[ ${#PKG_ARGS[@]} -ge 1 ]] || die "missing package name (try 'abuild --help')"
  MAIN_PKG="${PKG_ARGS[0]}"
  declare -a EXTRA_DEPS=("${PKG_ARGS[@]:1}")

  # 1. AUR Preflight
  spin_start "Resolving ${C_BOLD}${MAIN_PKG}${C_RESET} on AUR..."
  aur_query_url="https://aur.archlinux.org/rpc/v5/info"
  first=1
  for p in "${PKG_ARGS[@]}"; do
    (( first )) && aur_query_url+="?arg[]=${p}" || aur_query_url+="&arg[]=${p}"
    first=0
  done

  aur_res="$(curl -sf "$aur_query_url" || true)"
  [[ -n "$aur_res" ]] || die "Failed to connect to AUR RPC"
  for p in "${PKG_ARGS[@]}"; do
    p_ver="$(printf "%s" "$aur_res" | jq -r --arg p "$p" '.results[]? | select(.Name == $p) | .Version' 2>/dev/null || true)"
    [[ -n "$p_ver" ]] || die "Package '${C_BOLD}${p}${C_RESET}' not found on AUR"
  done

  # 2. Workflow Dispatch
  spin_set "Dispatching ${C_BOLD}${MAIN_PKG}${C_RESET} to ${REPO}..."
  deps_joined="${EXTRA_DEPS[*]:-}"
  gh workflow run "$WORKFLOW" -R "$REPO" -f "pkgname=$MAIN_PKG" -f "deps=$deps_joined" \
    || die "Workflow dispatch failed"

  spin_set "Waiting for runner to acknowledge ${C_BOLD}${MAIN_PKG}${C_RESET}..."
  for _ in {1..20}; do
    CURRENT_RUN_ID="$(gh run list -R "$REPO" -w "$WORKFLOW" -L 1 --json databaseId -q '.[0].databaseId' 2>/dev/null || true)"
    [[ -n "$CURRENT_RUN_ID" ]] && break
    sleep 1.5
  done
  [[ -n "$CURRENT_RUN_ID" ]] || die "Run did not appear in GitHub Actions"

  CURRENT_RUN_URL="https://github.com/$REPO/actions/runs/$CURRENT_RUN_ID"
  if (( DETACH )); then
    spin_stop ok "Dispatched ${C_BOLD}${MAIN_PKG}${C_RESET} ${C_DIM}(run #${CURRENT_RUN_ID})${C_RESET}"
    printf "    ${C_DIM}↳ Reattach:${C_RESET} abuild --attach %s\n" "$CURRENT_RUN_ID"
    printf "    ${C_DIM}↳ Remote:${C_RESET}   %s\n\n" "$CURRENT_RUN_URL"
    exit 0
  fi
fi

# --- Live Build Monitor ---
t_build_start=$(now_ms)
while true; do
  view_json="$(gh run view "$CURRENT_RUN_ID" -R "$REPO" --json status,conclusion,jobs,name 2>/dev/null || true)"
  if [[ -n "$view_json" ]]; then
    run_status="$(printf "%s" "$view_json" | jq -r '.status // empty' 2>/dev/null || true)"
    run_conclusion="$(printf "%s" "$view_json" | jq -r '.conclusion // empty' 2>/dev/null || true)"

    if [[ "$run_status" == "completed" ]]; then
      if [[ "$run_conclusion" == "success" ]]; then break; else
        spin_stop fail "Build failed with ${C_RED}${run_conclusion}${C_RESET}"
        printf "    ${C_RED}Logs:${C_RESET} gh run view %s -R %s --log-failed\n\n" "$CURRENT_RUN_ID" "$REPO"
        exit 1
      fi
    fi

    active_step="$(printf "%s" "$view_json" | jq -r '.jobs[0].steps[]? | select(.status == "in_progress") | .name' 2>/dev/null || true)"
    cur_time="$(format_time "$(( $(now_ms) - t_build_start ))")"
    spin_set "Building ${C_BOLD}${MAIN_PKG}${C_RESET} ${C_DIM}(${active_step:-$run_status} · ${cur_time})${C_RESET}"
  fi
  sleep 2.5
done

# --- Download Artifacts ---
spin_set "Downloading ${C_BOLD}${MAIN_PKG}${C_RESET} package artifacts..."
dest="$DL_DIR/$MAIN_PKG"; rm -rf "$dest"; mkdir -p "$dest"
gh run download "$CURRENT_RUN_ID" -R "$REPO" -D "$dest" >/dev/null || die "Failed to download build artifact"

declare -a pkgs=()
while IFS= read -r -d '' f; do pkgs+=("$f"); done < <(find "$dest" -name '*.pkg.tar.*' -type f -print0 | sort -z)
(( ${#pkgs[@]} )) || die "Downloaded artifact contained no package files (.pkg.tar.*)"

first_pkg="${pkgs[0]##*/}"
[[ "$MAIN_PKG" == "attached-build" ]] && MAIN_PKG="${first_pkg%%-[0-9]*}"

total_size="$(du -ch "${pkgs[@]}" | awk 'END{print $1}')"
total_time="$(format_time "$(( $(now_ms) - TOTAL_START ))")"
spin_stop ok "Ready: ${C_BOLD}${MAIN_PKG}${C_RESET} ${C_DIM}(${total_size} in ${total_time})${C_RESET}"

if (( NO_INSTALL )); then
  printf "    ${C_DIM}Install manually:${C_RESET} sudo pacman -U %s\n\n" "${pkgs[*]}"
  exit 0
fi

t_install_start=$(now_ms)
sudo pacman -U --noconfirm "${pkgs[@]}"
printf "  ${C_GREEN}✔${C_RESET} Installed ${C_BOLD}${MAIN_PKG}${C_RESET} ${C_DIM}($(format_time "$(( $(now_ms) - t_install_start ))"))${C_RESET}\n\n"
